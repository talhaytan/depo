# DEPO — Environment Configuration Example
# Copy this file to .env and replace secrets before deploying to production.

# Database connection string
# For local zero-config SQLite development/testing:
DATABASE_URL="file:./dev.db"

# For PostgreSQL production (use with prisma/schema.postgresql.prisma):
# DATABASE_URL="postgresql://depo_user:STRONG_PASSWORD_HERE@localhost:5432/depo_db?schema=public"

# JWT Session Secret (Must be at least 32 characters in production)
JWT_SECRET="replace-with-a-secure-32-character-random-secret-key"

# Initial Administrator Provisioning (Used only by `npm run db:seed` or initial CLI setup)
INITIAL_ADMIN_EMAIL="admin@depo.local"
INITIAL_ADMIN_PASSWORD="ChangeMeImmediately!2026"
INITIAL_ADMIN_NAME="Sistem Yöneticisi"
