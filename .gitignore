# Bağımlılıklar (Boyutu çok büyüktür, npm install ile kurulur)
/node_modules
/.pnp
.pnp.js

# Next.js derleme ve önbellek dosyaları
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Gizli ortam değişkenleri (.env.example yüklenir, .env yüklenmez)
.env
.env*.local

# Geçici SQLite journal dosyası (dev.db dahil edilir ki Vercel'de hazır veriyle açılsın)
prisma/*.db-journal

# Sistem ve log dosyaları
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
